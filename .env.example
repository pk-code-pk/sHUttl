# Live shuttle data source. Harvard retired PassioGO on 2026-07-01; the tracker
# behind Citymapper is a Ride Systems instance at shuttle.harvard.edu.
RIDESYSTEMS_BASE_URL=https://shuttle.harvard.edu/rtt/public
RIDESYSTEMS_PROJECT_TAG=1

# Retained so existing ?system_id= links and Redis cache keys keep working.
# Ride Systems has no system id; this now just means "Harvard".
PASSIO_SYSTEM_ID=831

REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
ENV=development

# --- Push reminders ---------------------------------------------------------
# Both transports are optional and independent: leave a group unset and that
# kind of client simply is not offered reminders. GET /push/config reports
# which are live.

# Web Push (browsers). Generate once with `python gen_vapid.py`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_EMAIL=mailto:you@example.com

# Apple Push Notification service (the iOS app).
# The key comes from Apple Developer > Certificates, Identifiers & Profiles >
# Keys > "+" with "Apple Push Notifications service (APNs)" ticked. Apple lets
# you download the .p8 file exactly once.
# APNS_KEY_ID is the 10-character Key ID shown next to that key.
# APNS_TEAM_ID is the 10-character Team ID under Membership details.
# APNS_AUTH_KEY is the CONTENTS of the .p8 file, not a path to it. It is a
# SECRET: anyone holding it can push to every install of the app. Never commit
# it. On one line, write the line breaks as \n, quoted as below.
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=DEF123GHIJ
# APNS_AUTH_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
# The app's bundle identifier; must match appId in frontend/capacitor.config.ts.
# APNS_BUNDLE_ID=live.shuttl.app
# production (TestFlight and the App Store) or sandbox (builds run from Xcode).
# This is only where a new device token is tried first: a token the chosen
# environment rejects is retried against the other one and remembered.
# APNS_ENVIRONMENT=production
