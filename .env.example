# Live shuttle data source. Harvard retired PassioGO on 2026-07-01; the tracker
# behind Citymapper is a Ride Systems instance at shuttle.harvard.edu.
RIDESYSTEMS_BASE_URL=https://shuttle.harvard.edu/rtt/public
RIDESYSTEMS_PROJECT_TAG=1

# Retained so existing ?system_id= links and Redis cache keys keep working.
# Ride Systems has no system id; this now just means "Harvard".
PASSIO_SYSTEM_ID=831

REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
ENV=development
