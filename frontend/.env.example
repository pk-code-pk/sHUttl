# Base URL for the Crimson Shuttle backend API
VITE_API_BASE_URL=http://localhost:8000

# Basemap: MapLibre GL vector styles. Defaults to CARTO Dark Matter / Positron,
# which are keyless. Override to point at any MapLibre style.json.
# VITE_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# VITE_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
# VITE_MAP_MAX_ZOOM=19
# VITE_MAP_MIN_ZOOM=11
