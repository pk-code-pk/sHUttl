# Base URL for the Crimson Shuttle backend API
VITE_API_BASE_URL=http://localhost:8000

# Basemap tiles. Defaults to Esri's keyless Dark Gray Canvas; CARTO now
# watermarks every tile it serves without a key. Override to use a keyed
# provider's free tier (embed the key in the URL).
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?api_key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; CARTO, &copy; OpenStreetMap contributors
# VITE_MAP_SUBDOMAINS=abcd
# VITE_MAP_MAX_ZOOM=20

# Vehicle marker style: "arrow" (default) or "bus".
# VITE_VEHICLE_ICON=bus
